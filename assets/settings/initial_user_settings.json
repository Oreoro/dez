// Dez settings
//
// Dez starts with one native Main Work Area for files, terminals, tools, and
// review. Projects stays closed until cross-Workspace supervision is useful.
// Balanced Lumin chrome, IBM Plex Sans interface text, and Lilex code and
// terminal text keep those native surfaces visually coherent.
//
// To see every Dez default without changing your custom settings, run
// `dez: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_family": "IBM Plex Sans",
  "ui_font_size": 14,
  "buffer_font_family": "Lilex",
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "Lumin Light",
    "dark": "Lumin Blur"
  },
  "design_system": {
    "density": "balanced"
  },
  "icon_theme": "Dez (Default)",
  "project_panel": {
    "starts_open": false
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true
  },
  "status_bar": {
    "experimental.show": true,
    "show_active_file": true,
    "line_endings_button": true
  },
  "markdown_preview_code_font_family": "Lilex",
  "terminal": {
    "font_family": "Lilex",
    "font_size": 14,
    "line_height": "standard",
    "alternate_scroll": "on",
    "button": true,
    "toolbar": {
      "breadcrumbs": false
    }
  }
}
