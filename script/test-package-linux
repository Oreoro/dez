#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

package_script="${PACKAGE_LINUX_SCRIPT:-script/package-linux}"
if [[ ! -x "$package_script" ]]; then
    echo "Missing executable package script: $package_script" >&2
    exit 1
fi

if [[ "$(uname -s)" != "Linux" ]]; then
    echo "Skipping Linux package integration tests on $(uname -s)."
    exit 0
fi

for command in cpio dpkg-deb file rpm rpm2cpio tar; do
    if ! command -v "$command" >/dev/null; then
        echo "Missing required test command: $command" >&2
        exit 1
    fi
done

temporary_directory="$(mktemp -d)"
trap 'rm -rf "$temporary_directory"' EXIT

create_fixture() {
    local channel="$1"
    local fixture_directory="$2"
    local application_suffix=""
    local application_id="dev.dez.dez"

    case "$channel" in
        stable)
            ;;
        preview)
            application_suffix="-preview"
            application_id="dev.dez.dez-Preview"
            ;;
        nightly)
            application_suffix="-nightly"
            application_id="dev.dez.dez-Nightly"
            ;;
        dev)
            application_suffix="-dev"
            application_id="dev.dez.dez-Dev"
            ;;
        *)
            echo "Unsupported fixture channel: $channel" >&2
            return 1
            ;;
    esac

    local application_directory="$fixture_directory/dez${application_suffix}.app"
    mkdir -p \
        "$application_directory/bin" \
        "$application_directory/lib" \
        "$application_directory/libexec" \
        "$application_directory/share/applications" \
        "$application_directory/share/icons/hicolor/512x512/apps" \
        "$application_directory/share/icons/hicolor/1024x1024/apps"

    printf '#!/usr/bin/env bash\nexit 0\n' >"$application_directory/bin/dez"
    printf '#!/usr/bin/env bash\nexit 0\n' >"$application_directory/libexec/dez-editor"
    chmod +x "$application_directory/bin/dez" "$application_directory/libexec/dez-editor"
    printf 'fixture library\n' >"$application_directory/lib/libfixture.so"
    printf 'fixture license\n' >"$application_directory/licenses.md"
    cp crates/dez/resources/app-icon.png \
        "$application_directory/share/icons/hicolor/512x512/apps/dez.png"
    cp crates/dez/resources/app-icon@2x.png \
        "$application_directory/share/icons/hicolor/1024x1024/apps/dez.png"

    sed \
        -e 's|$APP_NAME|dez Fixture|g' \
        -e 's|$APP_CLI|dez|g' \
        -e 's|$APP_ARGS|%U|g' \
        -e 's|$APP_ICON|dez|g' \
        -e 's|$DO_STARTUP_NOTIFY|true|g' \
        crates/dez/resources/dez.desktop.in \
        >"$application_directory/share/applications/$application_id.desktop"

    tar -czf "$fixture_directory/dez-linux-x86_64.tar.gz" \
        -C "$fixture_directory" \
        "dez${application_suffix}.app"
}

assert_file_contains() {
    local file="$1"
    local expected="$2"
    if ! grep -Fq "$expected" "$file"; then
        echo "Expected $file to contain: $expected" >&2
        exit 1
    fi
}

assert_command_fails() {
    if "$@" >/dev/null 2>&1; then
        echo "Expected command to fail: $*" >&2
        exit 1
    fi
}

extract_rpm_package() {
    local rpm_package="$1"
    local destination_directory="$2"
    local archive_path
    local rpm2cpio_error_path
    local cpio_error_path
    local cpio_exit_status

    archive_path="$(mktemp "$temporary_directory/rpm-archive.XXXXXX")"
    rpm2cpio_error_path="$(mktemp "$temporary_directory/rpm-rpm2cpio-error.XXXXXX")"
    cpio_error_path="$(mktemp "$temporary_directory/rpm-cpio-error.XXXXXX")"

    if ! rpm2cpio "$rpm_package" >"$archive_path" 2>"$rpm2cpio_error_path"; then
        # Debian/Ubuntu's libarchive-based rpm2cpio can exit non-zero with no
        # diagnostic output even after writing a complete cpio archive. Only
        # tolerate that exact signature; anything else is a real failure.
        if [[ -s "$rpm2cpio_error_path" ]] || [[ ! -s "$archive_path" ]]; then
            cat "$rpm2cpio_error_path" >&2
            rm -f "$archive_path" "$rpm2cpio_error_path" "$cpio_error_path"
            return 1
        fi
    fi
    rm -f "$rpm2cpio_error_path"

    if (
        cd "$destination_directory"
        cpio -idm --quiet --no-absolute-filenames <"$archive_path"
    ) 2>"$cpio_error_path"; then
        rm -f "$archive_path" "$cpio_error_path"
        return 0
    fi

    cpio_exit_status=$?
    if [[ "$cpio_exit_status" -eq 1 ]] && grep -Fxq "cpio: Removing leading \`/' from member names" "$cpio_error_path"; then
        rm -f "$archive_path" "$cpio_error_path"
        return 0
    fi

    cat "$cpio_error_path" >&2
    rm -f "$archive_path" "$cpio_error_path"
    return "$cpio_exit_status"
}

test_channel() {
    local channel="$1"
    local package_name="$2"
    local application_directory="$3"
    local application_id="$4"
    local case_directory="$temporary_directory/$channel"
    local output_directory="$case_directory/output"

    mkdir -p "$case_directory" "$output_directory"
    create_fixture "$channel" "$case_directory"

    "$package_script" \
        --archive "$case_directory/dez-linux-x86_64.tar.gz" \
        --output-dir "$output_directory" \
        --architecture x86_64 \
        --channel "$channel"

    local deb_package="$output_directory/dez-linux-x86_64.deb"
    local rpm_package="$output_directory/dez-linux-x86_64.rpm"
    [[ -f "$deb_package" ]]
    [[ -f "$rpm_package" ]]

    [[ "$(dpkg-deb -f "$deb_package" Package)" == "$package_name" ]]
    [[ "$(dpkg-deb -f "$deb_package" Architecture)" == "amd64" ]]
    [[ "$(rpm -qp --queryformat '%{NAME}' "$rpm_package")" == "$package_name" ]]
    [[ "$(rpm -qp --queryformat '%{ARCH}' "$rpm_package")" == "x86_64" ]]
    if [[ "$channel" == "stable" ]]; then
        [[ "$(dpkg-deb -f "$deb_package" Conflicts)" == *"dez-preview"* ]]
        [[ "$(rpm -qp --conflicts "$rpm_package")" == *"dez-preview"* ]]
    else
        [[ "$(dpkg-deb -f "$deb_package" Conflicts)" == *"dez"* ]]
        [[ "$(rpm -qp --conflicts "$rpm_package")" == *"dez"* ]]
    fi

    local deb_contents="$case_directory/deb-contents.txt"
    local rpm_contents="$case_directory/rpm-contents.txt"
    dpkg-deb --contents "$deb_package" >"$deb_contents"
    rpm -qlp "$rpm_package" >"$rpm_contents"

    for expected_path in \
        "/usr/bin/dez" \
        "/usr/lib/dez/$application_directory/bin/dez" \
        "/usr/lib/dez/$application_directory/lib/libfixture.so" \
        "/usr/lib/dez/$application_directory/libexec/dez-editor" \
        "/usr/lib/dez/$application_directory/licenses.md" \
        "/usr/share/applications/$application_id.desktop" \
        "/usr/share/icons/hicolor/512x512/apps/dez.png" \
        "/usr/share/icons/hicolor/1024x1024/apps/dez.png"
    do
        assert_file_contains "$deb_contents" ".$expected_path"
        assert_file_contains "$rpm_contents" "$expected_path"
    done

    local deb_root="$case_directory/deb-root"
    local rpm_root="$case_directory/rpm-root"
    mkdir -p "$deb_root" "$rpm_root"
    dpkg-deb -x "$deb_package" "$deb_root"
    extract_rpm_package "$rpm_package" "$rpm_root"

    local launched_binary="/usr/lib/dez/$application_directory/bin/dez"
    local package_root
    for package_root in "$deb_root" "$rpm_root"; do
        [[ -f "$package_root/usr/bin/dez" && -x "$package_root/usr/bin/dez" ]]
        assert_file_contains "$package_root/usr/bin/dez" "ZED_UPDATE_EXPLANATION"
        assert_file_contains "$package_root/usr/bin/dez" "exec \"$launched_binary\""
    done

    local desktop_file="$deb_root/usr/share/applications/$application_id.desktop"
    assert_file_contains "$desktop_file" "TryExec=/usr/bin/dez"
    assert_file_contains "$desktop_file" "Exec=/usr/bin/dez %U"
    assert_file_contains "$desktop_file" "Exec=/usr/bin/dez --new %U"
    assert_file_contains "$desktop_file" "Icon=dez"
}

test_channel stable dez dez.app dev.dez.dez
test_channel preview dez-preview dez-preview.app dev.dez.dez-Preview
test_channel nightly dez-nightly dez-nightly.app dev.dez.dez-Nightly
test_channel dev dez-dev dez-dev.app dev.dez.dez-Dev

negative_directory="$temporary_directory/negative"
mkdir -p "$negative_directory"
create_fixture stable "$negative_directory"

assert_command_fails "$package_script" \
    --archive "$negative_directory/dez-linux-x86_64.tar.gz" \
    --output-dir "$negative_directory/output" \
    --architecture mips64 \
    --channel stable

assert_command_fails "$package_script" \
    --archive "$negative_directory/dez-linux-x86_64.tar.gz" \
    --output-dir "$negative_directory/output" \
    --architecture x86_64 \
    --channel unknown

missing_editor_directory="$temporary_directory/missing-editor"
mkdir -p "$missing_editor_directory"
create_fixture stable "$missing_editor_directory"
tar -xzf "$missing_editor_directory/dez-linux-x86_64.tar.gz" -C "$missing_editor_directory"
rm "$missing_editor_directory/dez.app/libexec/dez-editor"
tar -czf "$missing_editor_directory/broken.tar.gz" -C "$missing_editor_directory" dez.app
assert_command_fails "$package_script" \
    --archive "$missing_editor_directory/broken.tar.gz" \
    --output-dir "$missing_editor_directory/output" \
    --architecture x86_64 \
    --channel stable

missing_desktop_directory="$temporary_directory/missing-desktop"
mkdir -p "$missing_desktop_directory"
create_fixture stable "$missing_desktop_directory"
tar -xzf "$missing_desktop_directory/dez-linux-x86_64.tar.gz" -C "$missing_desktop_directory"
rm "$missing_desktop_directory/dez.app/share/applications/dev.dez.dez.desktop"
tar -czf "$missing_desktop_directory/broken.tar.gz" -C "$missing_desktop_directory" dez.app
assert_command_fails "$package_script" \
    --archive "$missing_desktop_directory/broken.tar.gz" \
    --output-dir "$missing_desktop_directory/output" \
    --architecture x86_64 \
    --channel stable

missing_icon_directory="$temporary_directory/missing-icon"
mkdir -p "$missing_icon_directory"
create_fixture stable "$missing_icon_directory"
tar -xzf "$missing_icon_directory/dez-linux-x86_64.tar.gz" -C "$missing_icon_directory"
rm "$missing_icon_directory/dez.app/share/icons/hicolor/512x512/apps/dez.png"
tar -czf "$missing_icon_directory/broken.tar.gz" -C "$missing_icon_directory" dez.app
assert_command_fails "$package_script" \
    --archive "$missing_icon_directory/broken.tar.gz" \
    --output-dir "$missing_icon_directory/output" \
    --architecture x86_64 \
    --channel stable

echo "Linux package integration tests passed."
