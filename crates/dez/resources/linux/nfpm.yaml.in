name: "$PACKAGE_NAME"
arch: "$PACKAGE_ARCHITECTURE"
platform: "linux"
version: "$PACKAGE_VERSION"
section: "devel"
priority: "optional"
maintainer: "dez Team <hi@dez.dev>"
description: "The fast code editor."
vendor: "dez"
homepage: "https://github.com/shenghsi/dez"
license: "GPL-3.0-or-later"
conflicts: [$PACKAGE_CONFLICTS]
contents:
  - src: "$STAGED_APPLICATION_DIRECTORY/"
    dst: "/usr/lib/dez/$APPLICATION_DIRECTORY"
    type: tree
  - src: "$STAGED_LAUNCHER"
    dst: "/usr/bin/dez"
    file_info:
      mode: 0755
  - src: "$STAGED_DESKTOP_FILE"
    dst: "/usr/share/applications/$APPLICATION_ID.desktop"
  - src: "$STAGED_ICON_512"
    dst: "/usr/share/icons/hicolor/512x512/apps/dez.png"
  - src: "$STAGED_ICON_1024"
    dst: "/usr/share/icons/hicolor/1024x1024/apps/dez.png"
